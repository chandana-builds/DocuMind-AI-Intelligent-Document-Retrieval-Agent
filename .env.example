# ==========================================================
# DocuMind AI - Environment Configuration Example
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file with real credentials!
# ==========================================================

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=documind-documents-bucket

# AWS Credentials (Optional if using AWS CLI profiles, IAM Roles, or SSO)
# If using static access keys, supply them here:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3 Document Path / Prefix (Optional: defaults to "documents/")
S3_DOCUMENT_PREFIX=documents/

# LLM Provider Options: "bedrock", "openai", "gemini", or "none" (none triggers clear setup prompt)
LLM_PROVIDER=bedrock

# Bedrock Configuration
# Common supported models:
# - anthropic.claude-3-haiku-20240307-v1:0
# - anthropic.claude-3-5-sonnet-20240620-v1:0
# - amazon.titan-text-express-v1
# - amazon.nova-micro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# External LLM Provider API Keys (Optional, if LLM_PROVIDER is set to openai or gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Retrieval Settings
MAX_DOCUMENT_SIZE_MB=10
RETRIEVAL_TOP_K=4
PASSAGE_CHUNK_SIZE=400
PASSAGE_CHUNK_OVERLAP=60
